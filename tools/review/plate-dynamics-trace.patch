+/// Measurement only (design of the collision and welding fix): appends a line to the file named by
+/// `DEEPTIME_PLATE_TRACE`.
+pub(crate) fn trace(line: &str) {
+    if let Ok(path) = std::env::var("DEEPTIME_PLATE_TRACE") {
+        use std::io::Write;
+        if let Ok(mut f) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+        {
+            let _ = writeln!(f, "{line}");
+        }
+    }
+}
+
+/// Count, sum and second moments of a set of unit points (its extent along and across).
+#[derive(Default)]
+pub(crate) struct Mom {
+    n: u32,
+    s: DVec3,
+    m: [f64; 6],
+}
+
+impl Mom {
+    pub(crate) fn add(&mut self, p: DVec3) {
+        self.n += 1;
+        self.s += p;
+        for (k, v) in [
+            p.x * p.x,
+            p.y * p.y,
+            p.z * p.z,
+            p.x * p.y,
+            p.x * p.z,
+            p.y * p.z,
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            self.m[k] += v;
+        }
+    }
+
+    pub(crate) fn json(&self) -> String {
+        format!(
+            "[{},{},{},{},{},{},{},{},{},{}]",
+            self.n,
+            self.s.x,
+            self.s.y,
+            self.s.z,
+            self.m[0],
+            self.m[1],
+            self.m[2],
+            self.m[3],
+            self.m[4],
+            self.m[5]
+        )
+    }
+}
