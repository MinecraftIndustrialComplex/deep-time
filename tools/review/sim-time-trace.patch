EXPERIMENT, not part of the build (sim-time page, 2026-10-18). The span instrumentation the
profile on review/pages/sim-time/ was taken with: DEEPTIME_TRACE=<file> makes the bench write
one line per timer span (cat, what, start ns, end ns, process CPU ns at the end, tid, call site)
on CLOCK_MONOTONIC. It applies to master 25ae6723 (apply it with the usual patch tool, -p1).

diff --git a/crates/deeptime-core/src/trace.rs b/crates/deeptime-core/src/trace.rs
new file mode 100644
index 00000000..189bb2b3
--- /dev/null
+++ b/crates/deeptime-core/src/trace.rs
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//! EXPERIMENT, not for merge (the sim-time measurement, 2026-10-18): a span log.
+//!
+//! With `DEEPTIME_TRACE=<file>` set, every timer the stages already keep also writes one line
+//! per span: `cat \t what \t start_ns \t end_ns \t cpu_ns_at_end \t tid \t file:line`, the times
+//! on CLOCK_MONOTONIC (so they line up with `perf record -k CLOCK_MONOTONIC`) and the CPU time
+//! the whole process had used when the span ended (CLOCK_PROCESS_CPUTIME_ID). Without the
+//! variable nothing is written. The worlds do not change either way.
+
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+#[repr(C)]
+struct Timespec {
+    sec: i64,
+    nsec: i64,
+}
+
+unsafe extern "C" {
+    fn clock_gettime(clk: i32, ts: *mut Timespec) -> i32;
+    fn gettid() -> i32;
+}
+
+const CLOCK_MONOTONIC: i32 = 1;
+const CLOCK_PROCESS_CPUTIME_ID: i32 = 2;
+
+fn now_ns(clk: i32) -> i64 {
+    let mut ts = Timespec { sec: 0, nsec: 0 };
+    // SAFETY: a valid pointer to a timespec on the stack.
+    unsafe { clock_gettime(clk, &raw mut ts) };
+    ts.sec * 1_000_000_000 + ts.nsec
+}
+
+struct Sink {
+    out: std::io::BufWriter<std::fs::File>,
+    base_instant: Instant,
+    base_mono: i64,
+}
+
+static SINK: OnceLock<Option<Mutex<Sink>>> = OnceLock::new();
+
+fn sink() -> Option<&'static Mutex<Sink>> {
+    SINK.get_or_init(|| {
+        let path = std::env::var_os("DEEPTIME_TRACE")?;
+        let file = std::fs::File::create(path).ok()?;
+        let base_instant = Instant::now();
+        let base_mono = now_ns(CLOCK_MONOTONIC);
+        Some(Mutex::new(Sink {
+            out: std::io::BufWriter::with_capacity(1 << 20, file),
+            base_instant,
+            base_mono,
+        }))
+    })
+    .as_ref()
+}
+
+fn mono(s: &Sink, t: Instant) -> i64 {
+    match t.checked_duration_since(s.base_instant) {
+        Some(d) => s.base_mono + d.as_nanos() as i64,
+        None => s.base_mono - s.base_instant.duration_since(t).as_nanos() as i64,
+    }
+}
+
+/// Whether spans are being written.
+pub fn on() -> bool {
+    sink().is_some()
+}
+
+/// One span from `since` to now.
+#[track_caller]
+pub fn span(cat: &str, what: &str, since: Instant) {
+    let Some(m) = sink() else { return };
+    let end = Instant::now();
+    let cpu = now_ns(CLOCK_PROCESS_CPUTIME_ID);
+    // SAFETY: gettid has no preconditions.
+    let tid = unsafe { gettid() };
+    let loc = std::panic::Location::caller();
+    if let Ok(mut s) = m.lock() {
+        let (a, b) = (mono(&s, since), mono(&s, end));
+        let _ = writeln!(
+            s.out,
+            "{cat}\t{what}\t{a}\t{b}\t{cpu}\t{tid}\t{}:{}",
+            loc.file(),
+            loc.line()
+        );
+    }
+}
+
+/// A mark (a span of no length) with the process CPU time now: the cumulative CPU curve gets a
+/// point at a span's start.
+#[track_caller]
+pub fn mark(cat: &str, what: &str) {
+    if sink().is_some() {
+        span(cat, what, Instant::now());
+    }
+}
+
+/// Writes what is buffered (the CLI calls it before it exits).
+pub fn flush() {
+    if let Some(m) = sink()
+        && let Ok(mut s) = m.lock()
+    {
+        let _ = s.out.flush();
+    }
+}
