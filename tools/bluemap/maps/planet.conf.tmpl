# The Deep Time overworld as a player sees it.
world: "@WORLD@"
dimension: "minecraft:overworld"
name: "@LABEL@ — surface"
sorting: @SORT0@
start-pos: { x: @CX@, z: @CZ@ }
sky-color: "#7dabff"
void-color: "#000000"
sky-light: 1
ambient-light: 0.6   # Chunky-generated chunks may lack sky light; keep them readable
# Deep Time's floor is y -512; caves below sea level are hidden as in BlueMap's default look.
remove-caves-below-y: 55
cave-detection-ocean-floor: -5
cave-detection-uses-block-light: false
min-inhabited-time: 0
render-mask: [ @MASK@ ]
render-edges: true
edge-light-strength: 8
enable-perspective-view: true
enable-flat-view: true
enable-free-flight-view: true
enable-hires: true
storage: "file"
ignore-missing-light-data: true
marker-sets: {}
