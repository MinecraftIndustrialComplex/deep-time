# Gzip tiles, unzipped in the browser: render-bluemap.sh sets "clientDecompression": true in the web
# app's settings.json, so BlueMap's own loader fetches <tile>.prbm.gz and inflates it with
# DecompressionStream. A plain static host (spacesheep) needs no Content-Encoding header that way.
storage-type: file
root: "@WEBROOT@/maps"
compression: gzip
